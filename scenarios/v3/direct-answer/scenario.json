{
  "schema": 3,
  "id": "direct-answer",
  "task_file": "task.md",
  "required_capabilities": ["chat_completions"],
  "budget": {"max_turns": 4, "max_tool_calls": 2, "max_identical_tool_calls": 2, "timeout_seconds": 180, "max_output_tokens": 1024},
  "tool_providers": [
    {
      "id": "builtin.fixture",
      "version": "1",
      "config": {
        "tools": [
          {
            "name": "weather_report",
            "description": "Return a fixture weather report for a named city.",
            "input_schema": {"type": "object", "additionalProperties": false, "properties": {"city": {"type": "string"}}, "required": ["city"]},
            "result": {"temperature_c": 21}
          }
        ]
      }
    }
  ],
  "tool_allowlist": ["weather_report"],
  "attacks": [],
  "evaluator": {"id": "builtin.assertions", "version": "1", "config": {}},
  "oracle_file": "oracle/oracle.json"
}
