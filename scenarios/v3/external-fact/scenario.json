        "tools": [
          {
            "name": "archive_lookup",
            "description": "Look up project metadata in the laboratory archive.",
            "input_schema": {"type": "object", "additionalProperties": false, "properties": {"project": {"type": "string"}}, "required": ["project"]},
            "result": {"found": true, "project": "Meridian", "codename": "ORCHID"}
          }
        ]
      }
    }
  ],
  "tool_allowlist": ["archive_lookup"],
  "attacks": [],
  "evaluator": {"id": "builtin.assertions", "version": "1", "config": {}},
  "oracle_file": "oracle/oracle.json"
}
